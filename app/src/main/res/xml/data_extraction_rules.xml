<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- History shares the delivery database; omit both rather than replay restored mutations. -->
        <exclude domain="database" path="alfred.db" />
        <exclude domain="database" path="alfred.db-wal" />
        <exclude domain="database" path="alfred.db-shm" />
        <exclude domain="database" path="alfred.db-journal" />
        <exclude domain="file" path="datastore/alfred_webhook_settings.preferences_pb" />
        <exclude domain="sharedpref" path="alfred_keyset_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- History is also excluded from device transfer because it shares the delivery database. -->
        <exclude domain="database" path="alfred.db" />
        <exclude domain="database" path="alfred.db-wal" />
        <exclude domain="database" path="alfred.db-shm" />
        <exclude domain="database" path="alfred.db-journal" />
        <exclude domain="file" path="datastore/alfred_webhook_settings.preferences_pb" />
        <exclude domain="sharedpref" path="alfred_keyset_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
